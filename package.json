{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run test:node && npm run test:python",
    "test:node": "npm run build && node --experimental-strip-types --test \"tests/*.test.mjs\"",
    "test:python": "node scripts/python.mjs -m pytest backend/tests -q --basetemp=.pytest-tmp",
    "agent:demo": "node scripts/python.mjs -m backend.skilldoctor.cli run",
    "agent:replay": "node scripts/python.mjs -m backend.skilldoctor.cli run --executor replay --skill-id tdd-workflow",
    "agent:codex": "node scripts/python.mjs -m backend.skilldoctor.cli run --executor codex --skill-id tdd-workflow",
    "agent:api": "node scripts/python.mjs -m backend.skilldoctor.http_server --port 8010",
    "agent:api:fastapi": "node scripts/python.mjs -m uvicorn backend.skilldoctor.api:app --host 0.0.0.0 --port 8010",
    "analyze": "node --experimental-strip-types scripts/analyze-trace.mjs",
    "bench:fetch": "node scripts/fetch-swe-skills-bench.mjs",
    "bench:paired": "node --experimental-strip-types scripts/run-paired-codex-benchmark.mjs",
    "bench:skills": "node --experimental-strip-types scripts/run-codex-skill-smoke.mjs",
    "codex:import": "node --experimental-strip-types scripts/import-codex-jsonl.mjs",
    "record:example": "node --experimental-strip-types examples/instrumented-agent.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.145.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^7.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
