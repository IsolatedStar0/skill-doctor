# Local execution is the source of truth. LangSmith mirroring is optional.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=skill-doctor-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

# Backend HTTP API defaults are cloud/sandbox friendly.
SKILL_DOCTOR_HOST=0.0.0.0
SKILL_DOCTOR_CORS_ORIGINS=*
SKILL_DOCTOR_INGEST_API_KEY=

# Frontend falls back to http://localhost:8010 for local development.
# GitHub Pages can inject the hosted backend URL via repository variable
# NEXT_PUBLIC_SKILL_DOCTOR_API_URL; render.yaml defaults to the URL below.
NEXT_PUBLIC_SKILL_DOCTOR_API_URL=http://localhost:8010
